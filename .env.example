# -------- Supabase (Settings → API) --------
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# -------- Formularze kontaktowe (Resend) --------
# Klucze dla Supabase Edge Function `send-contact`. Wszystkie
# formularze na stronie (Kontakt, Cennik, Konsultacja, Newsletter,
# Kalkulator, Generator Briefu, Chatbot, Footer) przechodzą przez
# ten endpoint. Sekrety ustaw w Lovable Cloud / Supabase.
#
# Wymagane:
RESEND_API_KEY=""
#
# Opcjonalne (jeśli puste, używane są wartości domyślne):
#   CONTACT_INBOX  — adres odbiorczy (domyślnie a.mazziarz@gmail.com)
#   CONTACT_FROM   — pole "From" (domyślnie onboarding@resend.dev)
CONTACT_INBOX=""
CONTACT_FROM=""

# -------- (opcjonalnie) dev/preview --------
# Jeśli chcesz, żeby lokalne `vite dev` uderzało w zdalny endpoint
# (np. deploy preview), ustaw pełny URL. W produkcji zostaw pusty.
VITE_CONTACT_ENDPOINT=""

# -------- Analityka marketingowa (ładowana dopiero po zgodzie) --------
VITE_GTM_CONTAINER_ID=""
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""
VITE_AHREFS_ANALYTICS_KEY=""

# -------- Meta Conversions API (wyłącznie sekrety Edge Functions) --------
META_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""
META_GRAPH_API_VERSION=""
# Tylko podczas testów w Events Manager; usuń przed produkcją.
META_TEST_EVENT_CODE=""

# -------- FOTZ Connect Hub (tylko sekrety Edge Functions) --------
# Ustaw przez Lovable Cloud / Supabase secrets. Nigdy nie dodawaj prefiksu VITE_.
FOTZ_CONNECT_HUB_WEBHOOK_URL=""
FOTZ_CONNECT_HUB_WEBHOOK_SECRET=""
# Lista originów rozdzielona przecinkami. Domyślnie: preview Lovable, fotz.pl i localhost.
FOTZ_ALLOWED_ORIGINS=""
# Losowy sekret używany wyłącznie do hashowania limitów publicznych formularzy.
FOTZ_RATE_LIMIT_SALT=""
